#!/usr/bin/env python3
"""codeome-agent — run Codex specialist jobs and record Claude subagent jobs.

Installed by Codeome at <project>/.codeome/bin/codeome-agent. Standard library
only, so it runs on a Mac and on the HPC alike. Every job gets a folder in
<project>/.codeome/jobs/<id>/ holding job.json, brief.md, log.txt,
events.jsonl and result.md; Codeome's Agent chat and Jobs list read those folders.

  codeome-agent codex --role ROLE --title TITLE [--worktree] [--model M] [--resume SESSION] [--account NAME] < brief
  codeome-agent usage [--json]  (Claude and Codex limits per account, as Codeome last saw them)
  codeome-agent list [--json] [--limit N]
  codeome-agent show ID [--brief | --log]
  codeome-agent cancel ID
  codeome-agent pause ID
  codeome-agent progress [--job ID] [--stage ID] [--label TEXT] [--state waiting|running|done|failed] [--done N --total M --unit U] [--baseline SECONDS] [--plan id:label,id:label,...]
  codeome-agent watch --parser vitest|pytest|tsc|snakemake|regex|slurm --label TEXT --task KEY [--log FILE | --remote-log /ABS/PATH | --jobs ID[,ID...]] [--total N] [--pid P] [--stage ID] [--regex PATTERN] [--timeout SECONDS] [--quiet]
  codeome-agent hook            (Claude Code hook: PreToolUse/SubagentStart/SubagentStop JSON on stdin)
"""
import argparse
import json
import math
import multiprocessing
import os
import re
try:
    import resource
except ImportError:
    resource = None
import secrets
import select
import signal
import stat
import statistics
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
try:
    import fcntl
except ImportError:
    fcntl = None

ROOT = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
JOBS = os.path.join(ROOT, '.codeome', 'jobs')
PENDING = os.path.join(JOBS, '.pending')
WRITE_TOOLS = {'Edit', 'Write', 'NotebookEdit'}
CODEOME_HOME = os.environ.get('CODEOME_HOME') or os.path.expanduser('~/.codeome')
STALE_S = 30 * 60
EX_LIMIT = 75  # held back: every account is past the usage limit


# ---------- job records ----------
def now_iso():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def now_progress_iso():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%S.%fZ')


def parse_iso(s):
    for format in ('%Y-%m-%dT%H:%M:%S.%fZ', '%Y-%m-%dT%H:%M:%SZ'):
        try:
            return datetime.strptime(s, format).replace(tzinfo=timezone.utc).timestamp()
        except (TypeError, ValueError):
            pass
    return None


def safe(s):
    return re.sub(r'[^a-z0-9]+', '-', str(s or 'job').lower()).strip('-')[:32] or 'job'


def new_job_id(role):
    return '%s-%s-%s' % (time.strftime('%Y%m%d-%H%M%S'), safe(role), secrets.token_hex(2))


def job_dir(job_id):
    return os.path.join(JOBS, job_id)


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp.' + secrets.token_hex(4)
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def write_text(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, 'w', encoding='utf-8') as f:
        f.write(text)


def read_text(path, default=''):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return default


def load_job(job_id):
    try:
        with open(os.path.join(job_dir(job_id), 'job.json'), encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save_job(job):
    write_json(os.path.join(job_dir(job['id']), 'job.json'), job)


def pid_alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, OverflowError):
        return False
    except PermissionError:
        return True


def all_jobs():
    try:
        names = [n for n in os.listdir(JOBS) if not n.startswith('.')]
    except OSError:
        return []
    jobs = [j for j in (load_job(n) for n in names) if j]
    for j in jobs:
        # A Codex job whose wrapper died without recording an outcome.
        if j.get('status') in ('running', 'pausing') and j.get('engine') == 'codex' and not pid_alive(j.get('pid')):
            j['status'] = 'paused' if j.get('status') == 'pausing' and j.get('session') else 'lost'
    jobs.sort(key=lambda j: j.get('startedAt') or '', reverse=True)
    return jobs


def find_job(prefix):
    matches = [j for j in all_jobs() if j['id'].startswith(prefix) or j['id'].endswith(prefix)]
    if len(matches) != 1:
        sys.exit('codeome-agent: %s job matches "%s"' % ('no' if not matches else 'more than one', prefix))
    return matches[0]


def duration(job):
    a, b = parse_iso(job.get('startedAt')), parse_iso(job.get('endedAt')) or time.time()
    if a is None:
        return ''
    s = int(b - a)
    return '%dh%02dm' % (s // 3600, s % 3600 // 60) if s >= 3600 else '%dm%02ds' % (s // 60, s % 60)


# ---------- stage progress ----------
def progress_text(path):
    try:
        info = os.stat(path, follow_symlinks=False)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 256 * 1024:
            return ''
        fd = os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | os.O_NONBLOCK)
        try:
            opened = os.fstat(fd)
            if not stat.S_ISREG(opened.st_mode) or opened.st_size > 256 * 1024:
                return ''
            chunks, remaining = [], 256 * 1024 + 1
            while remaining:
                chunk = os.read(fd, remaining)
                if not chunk:
                    break
                chunks.append(chunk)
                remaining -= len(chunk)
            content = b''.join(chunks)
            return content.decode('utf-8') if len(content) <= 256 * 1024 else ''
        finally:
            os.close(fd)
    except (OSError, UnicodeError):
        return ''


def progress_lock(path):
    fd = None
    try:
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
        if fcntl is not None:
            fcntl.flock(fd, fcntl.LOCK_EX)
        return fd
    except OSError:
        if fd is not None:
            os.close(fd)
        return None


def progress_unlock(fd):
    if fd is not None:
        try:
            os.close(fd)
        except OSError:
            pass


def progress_history():
    try:
        data = json.loads(progress_text(os.path.join(JOBS, '.progress-history.json')))
    except ValueError:
        return {}
    if not isinstance(data, dict):
        return {}
    return {k: [v for v in values[-5:] if isinstance(v, (int, float)) and not isinstance(v, bool)
                and math.isfinite(v) and v >= 1]
            for k, values in list(data.items())[-500:] if isinstance(k, str) and isinstance(values, list)}


def progress_stage(stage_id, label, stamp, history):
    values = history.get(stage_id) or []
    return {'id': stage_id, 'label': label, 'state': 'waiting', 'kind': 'indeterminate',
            'done': 0, 'total': None, 'unit': None, 'startedAt': None, 'endedAt': None,
            'updatedAt': stamp, 'baselineSeconds': statistics.median(values) if values else None}


def progress_number(value, name, integer=False):
    try:
        number = int(value) if integer else float(value)
    except (TypeError, ValueError, OverflowError):
        raise ValueError('%s must be a number' % name)
    if not math.isfinite(number) or (name != '--done' and number < 0):
        raise ValueError('%s must be non-negative and finite' % name)
    return number


def cmd_progress(a):
    job_id = a.job if a.job is not None else os.environ.get('CODEOME_JOB_ID')
    if not job_id or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]*', job_id) or '..' in job_id or not os.path.isfile(os.path.join(job_dir(job_id), 'job.json')):
        print('codeome-agent: warning: missing or invalid progress job id', file=sys.stderr)
        return
    lock_fd = progress_lock(os.path.join(job_dir(job_id), '.progress.lock'))
    try:
        if not a.stage and not a.plan:
            raise ValueError('--stage or --plan is required')
        if a.state is not None and a.state not in ('waiting', 'running', 'done', 'failed'):
            raise ValueError('--state must be waiting, running, done or failed')
        done = progress_number(a.done, '--done', True) if a.done is not None else None
        total = progress_number(a.total, '--total', True) if a.total is not None else None
        baseline = progress_number(a.baseline, '--baseline') if a.baseline is not None else None
        if not a.stage and any(x is not None for x in (a.label, a.state, a.done, a.total, a.unit, a.baseline)):
            raise ValueError('stage options require --stage')
        plan = []
        if a.plan:
            for item in a.plan.split(','):
                if ':' not in item or not item.split(':', 1)[0]:
                    raise ValueError('--plan requires id:label entries')
                stage_id, label = item.split(':', 1)
                plan.append((stage_id[:40], label[:120] or stage_id[:40]))
        stamp = now_progress_iso()
        history = progress_history()
        progress_path = os.path.join(job_dir(job_id), 'progress.json')
        try:
            old = json.loads(progress_text(progress_path))
        except ValueError:
            old = None
        stages = []
        if isinstance(old, dict) and old.get('v') == 1 and isinstance(old.get('stages'), list):
            for item in old['stages']:
                if not isinstance(item, dict) or not isinstance(item.get('id'), str) or not item['id']:
                    continue
                stage_id = item['id'][:40]
                if any(s['id'] == stage_id for s in stages) or len(stages) >= 50:
                    continue
                stage = progress_stage(stage_id, str(item.get('label') or stage_id)[:120], stamp, history)
                stage.update({k: item[k] for k in stage if k in item})
                stage['id'], stage['label'] = stage_id, str(stage['label'])[:120]
                if stage['state'] not in ('waiting', 'running', 'done', 'failed'):
                    stage['state'] = 'waiting'
                if not isinstance(stage['total'], int) or isinstance(stage['total'], bool) or stage['total'] < 0:
                    stage['total'] = None
                if not isinstance(stage['done'], int) or isinstance(stage['done'], bool):
                    stage['done'] = 0
                stage['done'] = max(0, min(stage['done'], stage['total'])) if stage['total'] is not None else max(0, stage['done'])
                stage['kind'] = 'determinate' if stage['total'] is not None else 'indeterminate'
                stage['unit'] = str(stage['unit'])[:20] if stage['unit'] is not None else None
                if not isinstance(stage['baselineSeconds'], (int, float)) or isinstance(stage['baselineSeconds'], bool) or not math.isfinite(stage['baselineSeconds']) or stage['baselineSeconds'] < 0:
                    # A finished stage keeps what it had: refilling it from history would give it its own duration.
                    stage['baselineSeconds'] = progress_stage(stage_id, stage['label'], stamp, history)['baselineSeconds'] if stage['state'] in ('waiting', 'running') else None
                stages.append(stage)
        for stage_id, label in plan:
            if not any(s['id'] == stage_id for s in stages) and len(stages) < 50:
                stages.append(progress_stage(stage_id, label, stamp, history))
        if a.stage:
            stage_id = a.stage[:40]
            if not stage_id:
                raise ValueError('--stage must not be empty')
            stage = next((s for s in stages if s['id'] == stage_id), None)
            if stage is None:
                if len(stages) >= 50:
                    raise ValueError('progress is limited to 50 stages')
                stage = progress_stage(stage_id, (a.label or stage_id)[:120], stamp, history)
                stages.append(stage)
            previous = stage['state']
            if a.label is not None:
                stage['label'] = a.label[:120]
            if a.state is not None:
                stage['state'] = a.state
            elif previous == 'waiting':
                stage['state'] = 'running'
            if total is not None:
                stage['total'] = total
            if done is not None:
                stage['done'] = done
            stage['done'] = max(0, min(stage['done'], stage['total'])) if stage['total'] is not None else max(0, stage['done'])
            stage['kind'] = 'determinate' if stage['total'] is not None else 'indeterminate'
            if a.unit is not None:
                stage['unit'] = a.unit[:20]
            if baseline is not None:
                stage['baselineSeconds'] = baseline
            if stage['baselineSeconds'] is None and history.get(stage_id):
                stage['baselineSeconds'] = statistics.median(history[stage_id])
            if stage['state'] == 'running':
                if previous in ('done', 'failed') or not stage['startedAt']:
                    stage['startedAt'] = stamp
                stage['endedAt'] = None
            if stage['state'] == 'done' or (stage['state'] == 'failed' and not stage['endedAt']):
                stage['endedAt'] = stamp
            stage['updatedAt'] = stamp
            if stage['state'] == 'done' and previous != 'done':
                start, end = parse_iso(stage['startedAt']), parse_iso(stage['endedAt'])
                if start is not None and end is not None and end - start >= 1:
                    history_fd = progress_lock(os.path.join(JOBS, '.progress-history.lock'))
                    try:
                        history = progress_history()
                        if stage_id not in history and len(history) >= 500:
                            history.pop(next(iter(history)))
                        history[stage_id] = (history.get(stage_id) or [])[-4:] + [end - start]
                        write_json(os.path.join(JOBS, '.progress-history.json'), history)
                    finally:
                        progress_unlock(history_fd)
        write_json(progress_path, {'v': 1, 'updatedAt': stamp, 'stages': stages})
    except (OSError, ValueError, TypeError) as e:
        print('codeome-agent: warning: progress: %s' % e, file=sys.stderr)
    finally:
        progress_unlock(lock_fd)


# ---------- log progress watcher ----------
WATCH_KEY = re.compile(r'[A-Za-z0-9][\w.-]{0,63}\Z')
WATCH_VITEST = re.compile(r'^\s*([✓✗×↓-])\s+([A-Za-z0-9_./@-]+\.(?:test|spec)\.[cm]?[jt]sx?)')
WATCH_PERCENT = re.compile(r'\[\s*(\d{1,3})%\]')
WATCH_TSC_COUNT = re.compile(r'^\D*(\d+) of (\d+)')
WATCH_TSC_BUILD = re.compile(r"Building project '([^']+)'")
WATCH_TSC_CURRENT = re.compile(r"Project '([^']+)' is up to date")
WATCH_SNAKEMAKE_PROGRESS = re.compile(r'^\s*(\d+) of (\d+) steps \((\d+(?:\.\d+)?)%\) done\s*$')
WATCH_SNAKEMAKE_TOTAL = re.compile(r'^total\s+(\d+)\s*$')
WATCH_SNAKEMAKE_FINISHED = re.compile(r'^Finished (?:jobid: (\d+)|job (\d+)\.)')
WATCH_SNAKEMAKE_JOBID = re.compile(r'^\s+jobid: (\d+)\s*$')
WATCH_SNAKEMAKE_RESTART = re.compile(r'^Trying to restart job (\d+)\.')
WATCH_SNAKEMAKE_COMPLETE = re.compile(r'^Complete log(?:\(s\))?:')
WATCH_SNAKEMAKE_FAILURE = re.compile(r'^(?:Error in rule \S+:|MissingOutputException|Exiting because a job execution failed|LockException|IncompleteFilesException|WorkflowError)')
WATCH_ANSI = re.compile(r'\x1b\[[0-?]*[ -/]*[@-~]')
WATCH_SLURM_ID = re.compile(r'[0-9]{1,10}(?:_[0-9]{1,10})?\Z')
WATCH_SLURM_ROW = re.compile(r'([0-9]{1,10})(?:_([0-9]{1,10}|\[([^]]+)\]))?\Z')
WATCH_SLURM_RANGE = re.compile(r'([0-9]{1,10})(?:-([0-9]{1,10}))?(?:%[0-9]+)?\Z')
WATCH_SLURM_FAILURE = {'FAILED', 'OUT_OF_MEMORY', 'TIMEOUT', 'CANCELLED', 'NODE_FAIL',
                       'BOOT_FAIL', 'DEADLINE', 'REVOKED'}
WATCH_REMOTE_PATH = re.compile(r'/[A-Za-z0-9._@+=,:/-]{1,1023}\Z')


def watch_key_ok(key):
    return bool(key and WATCH_KEY.fullmatch(key) and '..' not in key)


def watch_real_dir(path):
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        os.mkdir(path)
        mode = os.lstat(path).st_mode
    if not stat.S_ISDIR(mode):
        raise ValueError('task path is not a real directory')


def watch_prune(tasks, current):
    dirs = []
    for name in os.listdir(tasks):
        if not watch_key_ok(name):
            continue
        path = os.path.join(tasks, name)
        try:
            info = os.lstat(path)
            if stat.S_ISDIR(info.st_mode):
                dirs.append((info.st_mtime, name, path))
        except OSError:
            continue
    dirs.sort(reverse=True)
    cutoff = time.time() - 7 * 86400
    for index, (mtime, name, path) in enumerate(dirs):
        if name == current or (mtime >= cutoff and index < 50):
            continue
        try:
            entries = os.listdir(path)
            if any(not (entry in ('progress.json', 'watch.json', '.progress.lock', '.watch.lock') or
                        re.fullmatch(r'(?:progress|watch)\.json\.tmp\.[A-Za-z0-9]+', entry)) or
                   stat.S_ISDIR(os.lstat(os.path.join(path, entry)).st_mode) for entry in entries):
                continue
            for entry in entries:
                os.unlink(os.path.join(path, entry))
            os.rmdir(path)
        except OSError:
            continue


def watch_regex_valid(pattern):
    if len(pattern) > 200 or re.search(r'\\[1-9]|\(\?P=', pattern):
        raise ValueError('--regex is too long or contains a backreference')
    compiled = re.compile(pattern)
    if 'done' not in compiled.groupindex:
        raise ValueError('--regex needs a named done group')
    stack = []
    in_class = False
    i = 0
    while i < len(pattern):
        char = pattern[i]
        if char == '\\':
            i += 2
            continue
        if char == '[':
            in_class = True
        elif char == ']':
            in_class = False
        elif not in_class:
            if char == '(':
                stack.append(False)
            elif char == ')' and stack:
                repeated = stack.pop()
                suffix = pattern[i + 1:]
                outer = bool(re.match(r'[+*]|\{\d+,\d*\}', suffix))
                if repeated and outer:
                    raise ValueError('--regex has nested quantifiers')
                if stack and (repeated or outer):
                    stack[-1] = True
            elif stack and (char in '+*' or re.match(r'\{\d+,\d*\}', pattern[i:])):
                stack[-1] = True
        i += 1
    return compiled


def watch_regex_worker(pattern, lines, conn, parent_pid):
    try:
        if resource is not None:
            try:
                resource.setrlimit(resource.RLIMIT_CPU, (3, 3))
            except (OSError, ValueError):
                pass
        matcher = re.compile(pattern)
        conn.send('ready')
        result = None
        for line in lines:
            if os.getppid() != parent_pid:
                return
            match = matcher.search(line)
            if match:
                result = (match.group('done'), match.groupdict().get('total'))
        if os.getppid() == parent_pid:
            conn.send(result)
    finally:
        conn.close()


def watch_regex_batch(pattern, lines):
    context = multiprocessing.get_context('spawn')
    parent, child = context.Pipe(False)
    process = context.Process(target=watch_regex_worker, args=(pattern, lines, child, os.getpid()))
    process.daemon = True
    process.start()
    child.close()
    try:
        parent.recv()  # Start the match budget after interpreter startup and compilation.
        if not parent.poll(2):
            process.kill()
            process.join()
            raise TimeoutError('regex parser timed out')
        return parent.recv()
    finally:
        parent.close()
        process.join()


def watch_pid_start(pid):
    try:
        result = subprocess.run(['ps', '-o', 'lstart=', '-p', str(pid)], capture_output=True,
                                text=True, timeout=2, check=False)
        return result.stdout.strip() or None
    except (OSError, subprocess.TimeoutExpired):
        return None


def watch_split_lines(chunk, offset, partial):
    data = partial + chunk
    pieces = data.split(b'\n')
    partial = pieces.pop()
    if len(pieces) > 20000:
        unread = b'\n'.join(pieces[20000:] + [partial])
        offset -= len(unread)
        partial = b''
        pieces = pieces[:20000]
    partial = partial[:2048]
    lines = [WATCH_ANSI.sub('', piece[:2048].decode('utf-8', errors='replace')) for piece in pieces]
    return offset, partial, lines


def watch_lines(fd, offset, partial, limit=1024 * 1024):
    size = os.fstat(fd).st_size
    if size < offset:
        offset, partial = 0, b''
    os.lseek(fd, offset, os.SEEK_SET)
    chunks = []
    remaining = min(max(0, size - offset), limit)
    while remaining:
        chunk = os.read(fd, min(remaining, 65536))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
        offset += len(chunk)
    return watch_split_lines(b''.join(chunks), offset, partial)


def watch_ssh_argv(remote, host, socket):
    argv = ['ssh', '-o', 'ControlPath=' + socket]
    if remote is None:
        return argv + ['-O', 'check', host]
    return argv + ['-o', 'ControlMaster=no', '-o', 'BatchMode=yes', '-o',
                   'ConnectTimeout=10', host, remote]


def watch_ssh(remote, host, socket, timeout, stopped=lambda: False):
    argv = watch_ssh_argv(remote, host, socket)
    process = subprocess.Popen(argv, shell=False, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, start_new_session=True)
    streams = [process.stdout, process.stderr]
    output = bytearray()
    diagnostics = bytearray()
    deadline = time.monotonic() + timeout
    try:
        while streams:
            if stopped():
                raise InterruptedError('watch stopped')
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            readable, _, _ = select.select(streams, [], [], min(0.2, remaining))
            for stream in readable:
                chunk = os.read(stream.fileno(), 65536)
                if not chunk:
                    streams.remove(stream)
                    continue
                target = output if stream is process.stdout else diagnostics
                cap = 1024 * 1024 if stream is process.stdout else 200
                available = cap - len(target)
                target.extend(chunk[:available])
                if stream is process.stdout and len(chunk) > available:
                    return 255, bytes(output), diagnostics.decode('utf-8', errors='replace')[:200]
        while process.poll() is None:
            if stopped():
                raise InterruptedError('watch stopped')
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            try:
                process.wait(timeout=min(0.2, remaining))
            except subprocess.TimeoutExpired:
                pass
        return process.returncode, bytes(output), diagnostics.decode('utf-8', errors='replace')[:200]
    finally:
        if process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
        process.stdout.close()
        process.stderr.close()


def watch_master(host, socket, timeout, stopped):
    # An unanswered check means no verified master; data timeouts instead count as poll failures.
    try:
        code, output, diagnostics = watch_ssh(None, host, socket, timeout, stopped)
        return code == 0 and b'Master running' in output or code == 0 and 'Master running' in diagnostics
    except (OSError, subprocess.TimeoutExpired):
        return False


def watch_interval(name, default, floor):
    try:
        value = float(os.environ.get(name, default))
        if not math.isfinite(value):
            raise ValueError
    except ValueError:
        value = default
    return max(0.01 if os.environ.get('CODEOME_WATCH_TEST') == '1' else floor, value)


def watch_default_timeout(parser, remote_log):
    return 259200 if parser == 'slurm' or remote_log is not None else 21600


def watch_sleep(seconds, stopped):
    deadline = time.monotonic() + seconds
    while not stopped():
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(0.25, remaining))


def watch_remote_path_ok(path):
    return bool(path and WATCH_REMOTE_PATH.fullmatch(path) and '//' not in path and
                '..' not in path.split('/'))


def watch_hpc_connection():
    host = os.environ.get('CODEOME_HPC_HOST')
    socket = os.environ.get('CODEOME_HPC_SOCKET')
    if not host or not socket:
        return None, None, 'HPC connection unavailable'
    if len(host) > 255 or host.startswith('-') or not re.fullmatch(r'[A-Za-z0-9._@-]+', host):
        return None, None, 'invalid HPC connection'
    if len(socket) > 4096 or '\n' in socket or '\r' in socket or '\x00' in socket:
        return None, None, 'invalid HPC connection'
    return host, socket, None


def watch_remote_lines(path, host, socket, timeout, offset, partial, stopped):
    try:
        code, raw_size, _stderr = watch_ssh("stat -c '%F|%s' -- " + path, host, socket, timeout, stopped)
        if code:
            error = 'connection' if code == 255 else 'missing'
            return offset, partial, [], 0, error if watch_master(host, socket, timeout, stopped) else 'unavailable'
        file_type, separator, raw_size = raw_size.strip().partition(b'|')
        if file_type not in (b'regular file', b'regular empty file') or not separator:
            return offset, partial, [], 0, 'not_regular'
        size = int(raw_size)
        if size < 0:
            return offset, partial, [], 0, 'connection'
        if size < offset:
            offset, partial = 0, b''
        code, chunk, _stderr = watch_ssh('tail -c +%d -- %s | head -c 1048576' % (offset + 1, path),
                                         host, socket, timeout, stopped)
        if code:
            error = 'connection' if code == 255 else 'missing'
            return offset, partial, [], size, error if watch_master(host, socket, timeout, stopped) else 'unavailable'
        offset += len(chunk)
        offset, partial, lines = watch_split_lines(chunk, offset, partial)
        return offset, partial, lines, size, None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return offset, partial, [], 0, 'connection' if stopped() or watch_master(host, socket, timeout, stopped) else 'unavailable'


def watch_slurm_rows(output):
    rows = {}
    for line in output.splitlines():
        job_id, separator, state = line.partition('|')
        if not separator or '.' in job_id:
            continue
        hit = WATCH_SLURM_ROW.fullmatch(job_id)
        if not hit:
            continue
        state = state.strip().split(' ', 1)[0]
        if not state:
            continue
        count = 1
        if hit.group(3) is not None:
            count = 0
            for part in hit.group(3).split(','):
                item = WATCH_SLURM_RANGE.fullmatch(part)
                if not item:
                    count = 0
                    break
                start = int(item.group(1))
                end = int(item.group(2)) if item.group(2) is not None else start
                if end < start:
                    count = 0
                    break
                count = min(100000, count + end - start + 1)
        if count:
            rows[job_id] = (count, state)
    return rows.values()


def watch_slurm_poll(a, stage, save, stopped):
    host, socket, reason = watch_hpc_connection()
    if reason:
        return reason
    # Environment overrides tune timing, not access control; model-run code can set them.
    poll = watch_interval('CODEOME_WATCH_SLURM_POLL', 30, 15)
    ssh_timeout = watch_interval('CODEOME_WATCH_SSH_TIMEOUT', 15, 5)
    deadline = time.monotonic() + progress_number(a.timeout, '--timeout')
    failures = empty = 0
    if not watch_master(host, socket, ssh_timeout, stopped):
        return 'stopped' if stopped() else 'HPC connection not available'
    while not stopped():
        if time.monotonic() >= deadline:
            return 'watch timed out'
        try:
            remote = 'sacct -X -n -P -j %s -o JobID,State' % a.jobs
            code, raw_output, _stderr = watch_ssh(remote, host, socket, ssh_timeout, stopped)
            output = raw_output.decode('utf-8', errors='replace')
        except (OSError, subprocess.TimeoutExpired):
            code, output = 1, ''
        if stopped():
            break
        if code:
            if not watch_master(host, socket, ssh_timeout, stopped):
                return 'stopped' if stopped() else 'HPC connection not available'
            empty = 0
            failures += 1
            if failures >= 3:
                return 'lost connection to HPC'
        else:
            failures = 0
            rows = list(watch_slurm_rows(output))
            if not rows:
                empty += 1
                if empty >= 3:
                    return 'no job data'
            else:
                empty = 0
                counted = sum(count for count, _ in rows)
                stage['done'] = sum(count for count, state in rows if state == 'COMPLETED')
                if a.total is None:
                    stage['total'] = max(stage['total'], counted)
                failed = any(state in WATCH_SLURM_FAILURE for _, state in rows)
                save()
                if all(state == 'COMPLETED' or state in WATCH_SLURM_FAILURE for _, state in rows):
                    stage['state'] = ('done' if not failed and stage['done'] >= stage['total']
                                      else 'failed')
                    return None
        watch_sleep(min(poll, max(0, deadline - time.monotonic())), stopped)
    return 'stopped'


def cmd_watch(a):
    if not watch_key_ok(a.task):
        raise ValueError('--task must be a safe key of at most 64 characters')
    if not a.label or not a.label.strip():
        raise ValueError('--label is required')
    if a.stage is not None and not a.stage:
        raise ValueError('--stage must not be empty')
    total = progress_number(a.total, '--total', True) if a.total is not None else None
    if total is not None and total < 1:
        raise ValueError('--total must be positive')
    if a.parser == 'vitest' and total is None:
        raise ValueError('vitest requires --total')
    if a.parser == 'slurm':
        ids = a.jobs.split(',') if a.jobs is not None else []
        if not ids or len(ids) > 50 or any(not WATCH_SLURM_ID.fullmatch(item) for item in ids):
            raise ValueError('slurm requires --jobs with 1 to 50 numeric job ids')
        if a.pid is not None:
            raise ValueError('--pid is not used with --parser slurm')
    elif a.jobs is not None:
        raise ValueError('--jobs requires --parser slurm')
    elif not a.log and not a.remote_log:
        raise ValueError('--log or --remote-log is required')
    if a.parser == 'regex':
        if not a.regex:
            raise ValueError('regex parser requires --regex')
        compiled = watch_regex_valid(a.regex)
        if total is None and 'total' not in compiled.groupindex:
            raise ValueError('regex parser requires --total or a named total group')
    elif a.regex is not None:
        raise ValueError('--regex requires --parser regex')
    if a.pid is not None and not 1 < a.pid < 2 ** 31:
        raise ValueError('--pid must be between 2 and 2147483647')
    if a.timeout is None:
        a.timeout = str(watch_default_timeout(a.parser, a.remote_log))
    timeout = progress_number(a.timeout, '--timeout')
    if timeout <= 0:
        raise ValueError('--timeout must be positive')
    poll = (watch_interval('CODEOME_WATCH_REMOTE_POLL', 5, 2) if a.remote_log else
            watch_interval('CODEOME_WATCH_POLL', 1, 1))
    wait = watch_interval('CODEOME_WATCH_WAIT', 30, 30)
    ssh_timeout = watch_interval('CODEOME_WATCH_SSH_TIMEOUT', 15, 5)
    task_root = os.path.join(JOBS, '.tasks')
    for directory in (os.path.join(ROOT, '.codeome'), JOBS, task_root, os.path.join(task_root, a.task)):
        watch_real_dir(directory)
    watch_prune(task_root, a.task)
    stage_id = (a.stage or a.parser)[:40]
    stamp = now_progress_iso()
    stage = progress_stage(stage_id, a.label[:120], stamp, progress_history())
    stage.update(state='running', kind='determinate', done=0, total=100 if a.parser == 'pytest' else total or 0,
                 unit={'vitest': 'files', 'pytest': '%', 'tsc': 'projects', 'snakemake': 'steps',
                       'regex': None, 'slurm': 'tasks'}[a.parser], startedAt=stamp)
    path = os.path.join(task_root, a.task, 'progress.json')
    last_written = None
    last_time = 0

    def save(force=False):
        nonlocal last_written, last_time
        current = (stage['state'], stage['done'], stage['total'])
        if current == last_written:
            return
        delay = 1 - (time.monotonic() - last_time)
        if delay > 0 and not force:
            return
        stamp = now_progress_iso()
        stage['updatedAt'] = stamp
        write_json(path, {'v': 1, 'updatedAt': stamp, 'stages': [stage]})
        last_written, last_time = current, time.monotonic()

    stopped = False

    def stop(_signal, _frame):
        nonlocal stopped
        stopped = True

    old_term = signal.signal(signal.SIGTERM, stop)
    old_int = signal.signal(signal.SIGINT, stop)
    fd = None
    reason = None
    try:
        save()
        if a.remote_log is not None:
            if a.parser == 'slurm':
                reason = '--remote-log is not used with --parser slurm'
            elif a.log is not None:
                reason = '--log and --remote-log are mutually exclusive'
            elif a.pid is not None:
                reason = '--pid is not used with --remote-log'
            elif not watch_remote_path_ok(a.remote_log):
                reason = 'invalid remote log path'
            if reason:
                return
        if a.parser == 'slurm':
            if a.log is not None:
                reason = '--log is not used with --parser slurm'
                return
            reason = watch_slurm_poll(a, stage, save, lambda: stopped)
            return
        remote_host = remote_socket = None
        if a.remote_log is not None:
            remote_host, remote_socket, reason = watch_hpc_connection()
            if reason:
                return
            if not watch_master(remote_host, remote_socket, ssh_timeout, lambda: stopped):
                reason = 'stopped' if stopped else 'HPC connection not available'
                return
        else:
            pid_start = watch_pid_start(a.pid) if a.pid is not None and pid_alive(a.pid) else None
            deadline = time.monotonic() + wait
            while not stopped and fd is None:
                try:
                    fd = os.open(a.log, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | os.O_NONBLOCK)
                    if not stat.S_ISREG(os.fstat(fd).st_mode):
                        raise ValueError('log is not a regular file')
                except FileNotFoundError:
                    if time.monotonic() >= deadline:
                        reason = 'log file did not appear'
                        break
                    watch_sleep(min(poll, max(0, deadline - time.monotonic())), lambda: stopped)
                except (OSError, ValueError) as e:
                    reason = 'cannot watch log: %s' % e
                    break
        if a.remote_log is not None:
            pid_start = None
        offset, partial, files, projects = 0, b'', set(), set()
        remote_failures = 0
        missing_since = None
        finished_jobs = set()
        snakemake_stats = False
        snakemake_progress = False
        snakemake_pending = False
        snakemake_fatal = False
        snakemake_errors = set()
        snakemake_error_block = False
        snakemake_summary_at = None
        snakemake_summary_lines = 0
        matched = False
        log_started = time.monotonic()
        warned = False
        failure = False
        summary = False

        def remote_problem(error):
            nonlocal remote_failures, missing_since
            if error == 'unavailable':
                return 'HPC connection not available'
            if error == 'not_regular':
                return 'remote log is not a regular file'
            if error == 'connection':
                missing_since = None
                remote_failures += 1
                return 'lost connection to HPC' if remote_failures >= 3 else None
            remote_failures = 0
            if missing_since is None:
                missing_since = time.monotonic()
            return 'log file did not appear' if time.monotonic() - missing_since >= wait else None

        def consume(lines):
            nonlocal matched, failure, summary, reason, snakemake_stats, snakemake_progress, snakemake_pending, snakemake_fatal
            nonlocal snakemake_error_block, snakemake_summary_at, snakemake_summary_lines
            if a.parser == 'regex' and lines:
                result = watch_regex_batch(a.regex, lines)
                if result is not None:
                    try:
                        done = int(result[0])
                        parsed_total = int(result[1]) if result[1] is not None else total
                        if done >= 0 and parsed_total is not None and parsed_total > 0:
                            stage['done'], stage['total'] = min(done, parsed_total), parsed_total
                            matched = True
                    except (ValueError, TypeError):
                        pass
            for line in lines if a.parser != 'regex' else ():
                if a.parser == 'vitest':
                    hit = WATCH_VITEST.match(line)
                    if hit:
                        if len(files) < 100000:
                            files.add(hit.group(2))
                        stage['done'] = min(len(files), stage['total'])
                        matched = True
                        failure |= hit.group(1) in ('✗', '×')
                    summary |= bool(re.match(r'^\s*Test Files\s', line))
                    failure |= bool(re.match(r'^\s*FAIL\b', line))
                    if re.match(r'^\s*(?:Test Files|Tests)\s', line):
                        failure |= bool(re.search(r'\b[1-9]\d*\s+failed\b', line, re.I))
                elif a.parser == 'pytest':
                    hit = WATCH_PERCENT.search(line)
                    if hit:
                        stage['done'] = min(int(hit.group(1)), 100)
                        matched = True
                    if re.match(r'^=+ .* in [\d.]+s', line):
                        summary = True
                        failure |= bool(re.search(r'\b[1-9]\d*\s+(?:failed|errors?)\b', line, re.I))
                elif a.parser == 'snakemake':
                    if line.startswith('Job stats:'):
                        snakemake_stats = True
                        snakemake_progress = snakemake_pending = snakemake_fatal = False
                        snakemake_error_block = False
                        snakemake_errors.clear()
                        finished_jobs.clear()
                        snakemake_summary_at = None
                        snakemake_summary_lines = 0
                        failure = summary = matched = False
                        stage['done'], stage['total'] = 0, total or 0
                    elif not line.strip():
                        snakemake_stats = False
                    hit = WATCH_SNAKEMAKE_TOTAL.match(line) if snakemake_stats and not snakemake_progress else None
                    if hit and total is None:
                        stage['total'] = int(hit.group(1))
                    hit = WATCH_SNAKEMAKE_PROGRESS.match(line)
                    if hit:
                        done, parsed_total = int(hit.group(1)), int(hit.group(2))
                        effective_total = total or parsed_total
                        if effective_total != stage['total']:
                            stage['done'], stage['total'] = min(done, effective_total), effective_total
                            finished_jobs.clear()
                            snakemake_errors.clear()
                            snakemake_error_block = False
                            snakemake_pending = snakemake_fatal = summary = False
                            snakemake_summary_at = None
                            snakemake_summary_lines = 0
                        else:
                            stage['done'] = max(stage['done'], min(done, effective_total))
                        snakemake_progress = matched = True
                        if stage['total'] > 0 and stage['done'] >= stage['total']:
                            snakemake_pending = bool(snakemake_errors)
                    elif not snakemake_progress:
                        hit = WATCH_SNAKEMAKE_FINISHED.match(line)
                        if hit and stage['total'] > 0:
                            if len(finished_jobs) < 100000:
                                finished_jobs.add(hit.group(1) or hit.group(2))
                            stage['done'] = min(len(finished_jobs), stage['total'])
                            matched = True
                            if stage['done'] >= stage['total']:
                                snakemake_pending = bool(snakemake_errors)
                    if line.startswith('Error in rule '):
                        snakemake_errors.add(None)
                        snakemake_error_block = True
                    elif snakemake_error_block:
                        hit = WATCH_SNAKEMAKE_JOBID.match(line)
                        if hit:
                            snakemake_errors.discard(None)
                            snakemake_errors.add(hit.group(1))
                            snakemake_error_block = False
                    hit = WATCH_SNAKEMAKE_RESTART.match(line)
                    if hit:
                        snakemake_errors.discard(hit.group(1))
                        snakemake_errors.discard(None)
                        snakemake_error_block = False
                        snakemake_pending = bool(snakemake_errors)
                    if WATCH_SNAKEMAKE_FAILURE.match(line):
                        snakemake_pending = True
                    if line.startswith(('LockException', 'IncompleteFilesException', 'Exiting because a job execution failed', 'WorkflowError:')):
                        snakemake_fatal = summary = True
                    elif line.startswith('Nothing to be done'):
                        stage['done'] = stage['total'] = 1
                        snakemake_pending = False
                        summary = matched = True
                    elif line.startswith('This was a dry-run'):
                        stage['done'] = stage['total']
                        summary = matched = True
                    elif WATCH_SNAKEMAKE_COMPLETE.match(line):
                        summary = True
                    if summary and snakemake_summary_at is None:
                        snakemake_summary_at = time.monotonic()
                    elif snakemake_summary_at is not None:
                        snakemake_summary_lines += 1
                else:
                    hit = WATCH_TSC_COUNT.match(line)
                    if hit:
                        stage['done'], stage['total'] = int(hit.group(1)), int(hit.group(2))
                        stage['done'] = min(stage['done'], stage['total'])
                        matched = True
                    else:
                        hit = WATCH_TSC_BUILD.search(line) or WATCH_TSC_CURRENT.search(line)
                        if hit:
                            if total is None:
                                reason = 'tsc project lines require --total'
                            else:
                                if len(projects) < 100000:
                                    projects.add(hit.group(1))
                                stage['done'], stage['total'] = min(len(projects), total), total
                                matched = True
                    failure |= bool(re.search(r'error TS\d+', line))

        while (fd is not None or a.remote_log is not None) and not reason and not stopped:
            if a.remote_log is not None:
                offset, partial, lines, remote_size, remote_error = watch_remote_lines(
                    a.remote_log, remote_host, remote_socket, ssh_timeout, offset, partial, lambda: stopped)
                if stopped:
                    break
                if remote_error:
                    reason = remote_problem(remote_error)
                    if not reason and time.monotonic() - log_started >= timeout:
                        reason = 'watch timed out'
                    if reason:
                        break
                    watch_sleep(poll, lambda: stopped)
                    continue
                remote_failures = 0
                missing_since = None
            else:
                offset, partial, lines = watch_lines(fd, offset, partial)
            try:
                consume(lines)
            except (TimeoutError, EOFError):
                reason = 'regex parser timed out'
                break
            save()
            if not matched and not warned and time.monotonic() - log_started >= 60:
                print('codeome-agent: warning: no progress lines matched; %s may need a verbose reporter' % a.parser, file=sys.stderr)
                warned = True
            ended = a.pid is not None and (not pid_alive(a.pid) or watch_pid_start(a.pid) != pid_start)
            snakemake_settled = (a.parser != 'snakemake' or ended or
                                 (a.pid is None and snakemake_summary_at is not None and
                                  (snakemake_summary_lines >= 20 or
                                   time.monotonic() - snakemake_summary_at >= min(2, max(0.2, 20 * poll)))))
            if (summary and snakemake_settled) or ended or (a.pid is None and a.parser in ('tsc', 'regex') and
                                    (failure or stage['total'] > 0 and stage['done'] >= stage['total'])):
                # Drain a large backlog before settling a finished process.
                drain_retry = False
                for _ in range(128):
                    if a.remote_log is not None:
                        if offset >= remote_size and _ > 0:
                            break
                        offset, partial, final_lines, remote_size, remote_error = watch_remote_lines(
                            a.remote_log, remote_host, remote_socket, ssh_timeout, offset, partial, lambda: stopped)
                        if stopped:
                            break
                        if remote_error:
                            reason = remote_problem(remote_error)
                            drain_retry = True
                            break
                        remote_failures = 0
                        missing_since = None
                    else:
                        offset, partial, final_lines = watch_lines(fd, offset, partial)
                    try:
                        consume(final_lines)
                    except (TimeoutError, EOFError):
                        reason = 'regex parser timed out'
                        break
                    if offset >= (remote_size if a.remote_log is not None else os.fstat(fd).st_size):
                        break
                if drain_retry:
                    if reason:
                        break
                    if time.monotonic() - log_started >= timeout:
                        reason = 'watch timed out'
                        break
                    watch_sleep(poll, lambda: stopped)
                    continue
                if partial:
                    try:
                        consume([WATCH_ANSI.sub('', partial.decode('utf-8', errors='replace'))])
                    except (TimeoutError, EOFError):
                        reason = 'regex parser timed out'
                break
            if time.monotonic() - log_started >= timeout:
                reason = 'watch timed out'
                break
            watch_sleep(poll, lambda: stopped)
        stage['state'] = 'done' if not stopped and not reason and not failure and not snakemake_pending and not snakemake_fatal and stage['total'] > 0 and stage['done'] >= stage['total'] else 'failed'
    finally:
        if stage['state'] == 'running':
            stage['state'] = 'failed'
        stage['endedAt'] = now_progress_iso()
        try:
            save(force=True)
        except (OSError, ValueError, TypeError):
            pass
        if fd is not None:
            os.close(fd)
        signal.signal(signal.SIGTERM, old_term)
        signal.signal(signal.SIGINT, old_int)
        if stage['state'] == 'done':
            start, end = parse_iso(stage['startedAt']), parse_iso(stage['endedAt'])
            if start is not None and end is not None and end - start >= 1:
                history_fd = progress_lock(os.path.join(JOBS, '.progress-history.lock'))
                try:
                    history = progress_history()
                    if stage_id not in history and len(history) >= 500:
                        history.pop(next(iter(history)))
                    history[stage_id] = (history.get(stage_id) or [])[-4:] + [end - start]
                    write_json(os.path.join(JOBS, '.progress-history.json'), history)
                finally:
                    progress_unlock(history_fd)
        if reason or stopped:
            print('codeome-agent: warning: watch: %s' % (reason or 'stopped'), file=sys.stderr)
        if not a.quiet:
            print('codeome-agent: watch %s: %s (%s/%s %s)' %
                  (a.task, stage['state'], stage['done'], stage['total'], stage['unit'] or ''))


# ---------- roles ----------
def read_role(role):
    path = os.path.join(ROOT, '.claude', 'agents', role + '.md')
    text = read_text(path, None)
    if text is None:
        general = os.path.join(CODEOME_HOME, 'agents', role + '.md')
        text = read_text(general, None)
        if text is None:
            have = set(n[:-3] for n in os.listdir(os.path.dirname(path))) if os.path.isdir(os.path.dirname(path)) else set()
            if os.path.isdir(os.path.dirname(general)):
                have.update(n[:-3] for n in os.listdir(os.path.dirname(general)) if n.endswith('.md'))
            sys.exit('codeome-agent: no role "%s" in .claude/agents/ (installed: %s)' % (role, ', '.join(sorted(have)) or 'none'))
    meta, body = {}, text
    m = re.match(r'^---\n(.*?)\n---\n?(.*)$', text, re.S)
    if m:
        body = m.group(2)
        for line in m.group(1).splitlines():
            if ':' in line:
                k, v = line.split(':', 1)
                meta[k.strip()] = v.strip()
    tools = {t.strip() for t in meta.get('tools', '').split(',') if t.strip()}
    read_only = bool(tools) and not (tools & WRITE_TOOLS)
    return body.strip(), read_only


def configured(role, key, pattern):
    """A choice made for this role in Codeome's Settings (.codeome/agents.json)."""
    try:
        with open(os.path.join(ROOT, '.codeome', 'agents.json'), encoding='utf-8') as f:
            r = (json.load(f).get('roles') or {}).get(role)
    except (OSError, ValueError, AttributeError):
        return None
    m = r.get(key) if isinstance(r, dict) else None
    return m if isinstance(m, str) and re.match(pattern, m) else None


def configured_model(role):
    return configured(role, 'codexModel', r'^[\w.:/\[\]-]{1,80}$')


def configured_effort(role):
    return configured(role, 'codexEffort', r'^(minimal|low|medium|high|xhigh)$')


PREAMBLE = """You are the "{role}" specialist in a development team. An orchestrator (Claude Code) planned the work and sent you one job; it will verify your result and decide what happens next. You have no other context than what is below.

For measurable work, follow your role's Progress section and use `.codeome/bin/codeome-agent progress`. This Codex job's id is available as `$CODEOME_JOB_ID`.

# Your role
{body}

# Your job
{brief}
"""

FOLLOW_UP = """Follow-up from the orchestrator on the same job:

{brief}

End with the same report shape as before (Status, Changes, Checks, Notes for the orchestrator)."""


# ---------- usage limits ----------
# Codeome writes ~/.codeome/usage.json: per engine, the accounts (config folders),
# the active one, and the latest 5-hour and weekly readings. Without it (Codeome not
# running, or on the HPC) jobs run on the default account with no limit checks.
def load_usage():
    try:
        with open(os.path.join(CODEOME_HOME, 'usage.json'), encoding='utf-8') as f:
            u = json.load(f)
    except (OSError, ValueError):
        return None
    return u if isinstance(u, dict) and u.get('version') == 1 else None


def window_pct(w, now):
    if not w or w.get('pct') is None:
        return None
    return 0.0 if w.get('resetsAt') and w['resetsAt'] <= now else float(w['pct'])


def level(acct, now):
    """Highest use across the windows; None when nothing recent is known."""
    if not acct or not acct.get('asOf') or now - acct['asOf'] > STALE_S:
        return None
    if acct.get('reached'):
        return 100.0
    ws = acct.get('windows') or {}
    ps = [p for p in (window_pct(ws.get('fiveHour'), now), window_pct(ws.get('weekly'), now)) if p is not None]
    return max(ps) if ps else None


def pick_account(accounts, preferred, stop_at, now):
    """(account, blocked): the preferred account while it has headroom, else the one with the most."""
    if not accounts:
        return None, False
    pref = next((a for a in accounts if a.get('name') == preferred), accounts[0])
    lv = lambda a: level(a, now)
    headroom = lv(pref) is None or lv(pref) < stop_at
    if headroom and not pref.get('signedOut'):
        return pref, False
    # Accounts that are not signed in are never moved to.
    others = [a for a in accounts if a is not pref and not a.get('signedOut')]
    open_ = sorted((a for a in others if lv(a) is not None and lv(a) < stop_at), key=lv)
    if open_:
        return open_[0], False
    unknown = next((a for a in others if lv(a) is None), None)
    if unknown:
        return unknown, False
    return (pref, False) if headroom else (None, True)


def fmt_reset(ts):
    if not ts:
        return '?'
    return time.strftime('%H:%M' if ts - time.time() < 20 * 3600 else '%a %H:%M', time.localtime(ts))


def describe(acct, now):
    ws = acct.get('windows') or {}
    parts = []
    for key, label in (('fiveHour', '5-hour'), ('weekly', 'weekly')):
        p = window_pct(ws.get(key), now)
        if p is not None:
            parts.append('%s %d%% (resets %s)' % (label, p, fmt_reset(ws[key].get('resetsAt'))))
    return ', '.join(parts) or 'no recent reading'


def account_key(d):
    # Same rule as Codeome's accountKey() and codeome-statusline.
    if not d:
        return 'default'
    return re.sub(r'[^A-Za-z0-9]+', '_', os.path.realpath(os.path.expanduser(d))).strip('_')


def cmd_usage(a):
    u = load_usage()
    if a.json:
        print(json.dumps(u, indent=2))
        return
    if not u:
        print('No usage data: Codeome writes %s while it runs.' % os.path.join(CODEOME_HOME, 'usage.json'))
        return
    now, stop_at = time.time(), u.get('stopAt', 90)
    print('Jobs are held back at %d%% of the 5-hour or weekly limit.' % stop_at)
    for engine in ('claude', 'codex'):
        e = u.get(engine) or {}
        for acct in e.get('accounts') or []:
            lv = level(acct, now)
            state = 'unknown' if lv is None else ('LIMIT' if lv >= stop_at else ('near' if lv >= stop_at - 15 else 'ok'))
            print('%-6s %-14s %-8s %s%s' % (engine, acct.get('name'), state, describe(acct, now),
                                            '  (active)' if acct.get('name') == e.get('active') else ''))


# ---------- codex ----------
def git(*args):
    return subprocess.run(['git', '-C', ROOT] + list(args), capture_output=True, text=True)


LIMIT_HIT = re.compile(r"usage limit|rate limit reached|hit your (usage )?limit", re.I)


def choose_codex_account(a, prev):
    """The Codex account for this job; exits with EX_LIMIT when the job must be held back."""
    u = load_usage()
    if not u:
        return {'name': prev.get('account'), 'dir': prev.get('accountDir') or ''} if prev else None
    now, stop_at = time.time(), u.get('stopAt', 90)
    codex = u.get('codex') or {}
    accounts = codex.get('accounts') or []
    if prev:
        # A Codex session lives in one account's CODEX_HOME: follow-ups must stay there.
        d = prev.get('accountDir') or ''
        acct = next((x for x in accounts if account_key(x.get('dir')) == account_key(d)), None) or {'name': prev.get('account'), 'dir': d}
        lv = level(acct, now)
        if lv is not None and lv >= stop_at and not a.ignore_limits:
            hold('Codex account "%s", where session %s lives, is at %s. A follow-up cannot move to another account: '
                 'start a fresh job with the full brief instead, or wait.' % (acct.get('name'), a.resume, describe(acct, now)))
        return acct
    if a.account:
        acct = next((x for x in accounts if x.get('name') == a.account), None)
        if not acct:
            sys.exit('codeome-agent: no Codex account "%s" (have: %s)' % (a.account, ', '.join(x.get('name', '?') for x in accounts) or 'none'))
        lv = level(acct, now)
        if lv is not None and lv >= stop_at and not a.ignore_limits:
            hold('Codex account "%s" is at %s.' % (acct['name'], describe(acct, now)))
        return acct
    acct, blocked = pick_account(accounts, codex.get('active'), stop_at, now)
    if blocked:
        if not a.ignore_limits:
            hold('Every Codex account is past %d%%: %s.' % (stop_at, '; '.join('%s — %s' % (x.get('name'), describe(x, now)) for x in accounts)))
        acct = next((x for x in accounts if x.get('name') == codex.get('active')), accounts[0])
    if acct and acct.get('name') != codex.get('active'):
        print('codeome-agent: using Codex account "%s"; the active account is past its limit or unknown' % acct.get('name'), file=sys.stderr)
    lv = level(acct, now) if acct else None
    if lv is not None and stop_at - 15 <= lv < stop_at:
        print('codeome-agent: note: Codex account "%s" is at %s; jobs are held back at %d%%.' % (acct.get('name'), describe(acct, now), stop_at), file=sys.stderr)
    return acct


def hold(why):
    print('codeome-agent: job NOT started (usage limit). %s\n'
          'Do not retry in a loop. Route the job to Claude if its role allows, or pause and tell the user: '
          'they can add or switch accounts in Codeome, or wait for the reset.' % why)
    sys.exit(EX_LIMIT)


def linked_dirs():
    """Folders of the projects connected to this one (Codeome sets CODEOME_LINKED), as writable extras."""
    out = []
    for d in os.environ.get('CODEOME_LINKED', '').split(os.pathsep):
        d = d.strip()
        if d and os.path.isdir(d) and os.path.realpath(d) != os.path.realpath(ROOT) and d not in out:
            out.append(d)
    return out


def codex_event_line(event):
    """One readable log line for a Codex JSONL event."""
    kind = event.get('type') or 'event'
    item = event.get('item')
    if kind in ('item.started', 'item.completed') and isinstance(item, dict):
        kind = item.get('type') or kind
        if kind == 'command_execution':
            if event['type'] == 'item.started':
                return '[command] %s' % ' '.join(str(item.get('command') or '').split())
            output = str(item.get('aggregated_output') or '').splitlines()
            return '[exit %s]%s' % (item.get('exit_code'), ' ' + output[0] if output else '')
        if kind == 'agent_message':
            return '[codex] %s' % ' '.join(str(item.get('text') or '').split())
        return '[%s]' % kind
    if kind == 'thread.started':
        return '[thread.started] %s' % (event.get('thread_id') or '')
    error = event.get('error')
    message = event.get('message') or (error.get('message') if isinstance(error, dict) else error)
    return '[%s]%s' % (kind, ' ' + ' '.join(str(message).split()) if message else '')


def cmd_codex(a):
    brief = read_text(a.brief_file) if a.brief_file else sys.stdin.read()
    if not brief.strip():
        sys.exit('codeome-agent: empty brief (pass it on stdin or with --brief-file)')
    prev = None
    if a.resume:
        prev = next((j for j in all_jobs() if j.get('session') == a.resume), None)
    role = a.role or (prev and prev.get('role'))
    if not role:
        sys.exit('codeome-agent: --role is required')
    body, read_only = read_role(role)
    sandbox = a.sandbox or (prev and prev.get('sandbox')) or ('read-only' if read_only else 'workspace-write')
    account = choose_codex_account(a, prev)

    job_id = new_job_id(role)
    d = job_dir(job_id)
    os.makedirs(d, exist_ok=True)
    workdir, worktree, branch = ROOT, None, None
    if prev and prev.get('worktree'):
        workdir, worktree, branch = prev['worktree'], prev['worktree'], prev.get('branch')
    elif a.worktree:
        branch = 'codeome/' + job_id
        worktree = os.path.join(ROOT, '.codeome', 'worktrees', job_id)
        r = git('worktree', 'add', '-b', branch, worktree, 'HEAD')
        if r.returncode != 0:
            sys.exit('codeome-agent: could not create worktree: ' + r.stderr.strip())
        workdir = worktree
    in_git = git('rev-parse', '--is-inside-work-tree').returncode == 0

    result = os.path.join(d, 'result.md')
    log = os.path.join(d, 'log.txt')
    events = os.path.join(d, 'events.jsonl')
    prompt = FOLLOW_UP.format(brief=brief.strip()) if a.resume else PREAMBLE.format(role=role, body=body, brief=brief.strip())
    write_text(os.path.join(d, 'brief.md'), brief)

    codex = os.environ.get('CODEOME_CODEX', 'codex')
    if a.resume:
        argv = [codex, 'exec', 'resume', a.resume, '-c', 'sandbox_mode="%s"' % sandbox, '-o', result, '--json']
    else:
        argv = [codex, 'exec', '-C', workdir, '-s', sandbox, '-o', result, '--json']
        if sandbox == 'workspace-write':
            for d in linked_dirs():
                argv += ['--add-dir', d]
    model = a.model or configured_model(role)
    if model:
        argv += ['-m', model]
    effort = configured_effort(role)
    if effort:
        argv += ['-c', 'model_reasoning_effort="%s"' % effort]
    if not in_git:
        argv.append('--skip-git-repo-check')
    argv.append('-')

    env = dict(os.environ)
    env['CODEOME_JOB_ID'] = job_id
    if account:
        env.pop('CODEX_HOME', None)
        if account.get('dir'):
            env['CODEX_HOME'] = os.path.expanduser(account['dir'])

    job = {
        'id': job_id, 'engine': 'codex', 'role': role, 'title': a.title or role, 'status': 'running',
        'startedAt': now_iso(), 'endedAt': None, 'exitCode': None, 'pid': os.getpid(),
        'cwd': workdir, 'worktree': worktree, 'branch': branch, 'sandbox': sandbox,
        'model': model, 'session': a.resume, 'resumedFrom': prev['id'] if prev else None,
        'account': account.get('name') if account else None, 'accountDir': env.get('CODEX_HOME') or ''
    }
    save_job(job)

    logf = eventsf = None
    try:
        logf = open(log, 'w', encoding='utf-8', buffering=1)
        eventsf = open(events, 'w', encoding='utf-8', buffering=1)
        child = subprocess.Popen(argv, cwd=workdir, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=logf,
                                 text=True, encoding='utf-8', errors='replace', start_new_session=True, env=env)
    except OSError as e:
        if logf:
            logf.close()
        if eventsf:
            eventsf.close()
        job.update(status='failed', endedAt=now_iso(), exitCode=-1, error=str(e))
        save_job(job)
        sys.exit('codeome-agent: could not start %s: %s' % (codex, e))

    cancelled = {'v': False}
    paused = {'v': False}
    state_lock = threading.Lock()

    def stop(signum, _frame):
        cancelled['v'] = True
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            pass
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    control_path = os.path.join(job_dir(job_id), 'pause.fifo')
    control_read = control_write = None
    try:
        os.mkfifo(control_path, 0o600)
        control_read = os.open(control_path, os.O_RDONLY | os.O_NONBLOCK)
        control_write = os.open(control_path, os.O_WRONLY | os.O_NONBLOCK)
        job['pauseFifo'] = control_path
    except OSError:
        if control_read is not None:
            os.close(control_read)
        control_read = None
    control_done = threading.Event()

    def serve_pause():
        pending = b''
        while not control_done.is_set():
            try:
                ready, _, _ = select.select([control_read], [], [], 0.2)
                if not ready:
                    continue
                pending += os.read(control_read, 4096)
            except (OSError, ValueError):
                break
            while b'\n' in pending:
                request, pending = pending.split(b'\n', 1)
                requested_id, _, name = request.decode('ascii', errors='ignore').partition(' ')
                if requested_id != job_id:
                    continue
                if not re.fullmatch(r'pause-reply-[0-9a-f]{16}\.txt', name):
                    continue
                with state_lock:
                    if not job.get('session'):
                        reply = 'Cannot pause before the Codex session ID is captured.'
                    elif job['status'] != 'running' or child.poll() is not None:
                        reply = 'The Codex job has already stopped.'
                    else:
                        try:
                            os.killpg(child.pid, signal.SIGTERM)
                            paused['v'] = True
                            job['status'] = 'pausing'
                            save_job(job)
                            reply = 'ok'
                        except OSError:
                            reply = 'The Codex process has already stopped.'
                try:
                    reply_path = os.path.join(job_dir(job_id), name)
                    with open(reply_path + '.tmp', 'x', encoding='utf-8') as f:
                        f.write(reply)
                    os.replace(reply_path + '.tmp', reply_path)
                except OSError:
                    pass

    control_thread = None
    if control_read is not None:
        control_thread = threading.Thread(target=serve_pause, daemon=True)
        control_thread.start()

    job['childPid'] = child.pid
    save_job(job)
    if prev and prev.get('status') == 'paused' and not prev.get('resumedBy'):
        prev['resumedBy'] = job_id
        save_job(prev)
    seen_thread = {'v': False}

    def read_events():
        for line in iter(lambda: child.stdout.readline(1 << 20), ''):
            eventsf.write(line)
            try:
                event = json.loads(line)
            except ValueError:
                logf.write(line)
                continue
            if not isinstance(event, dict):
                logf.write(line)
                continue
            if event.get('type') == 'thread.started' and event.get('thread_id'):
                seen_thread['v'] = True
                job['session'] = event['thread_id']
                save_job(job)
            logf.write(codex_event_line(event) + '\n')

    reader = threading.Thread(target=read_events)
    reader.start()
    try:
        child.stdin.write(prompt)
        child.stdin.close()
    except BrokenPipeError:
        pass
    code = child.wait()
    reader.join(5)
    try:
        child.stdout.close()
    except OSError:
        pass
    reader.join(1)
    logf.close()
    eventsf.close()

    log_text = read_text(log)
    m = re.search(r'session id:\s*(\S+)', log_text)
    if m and not seen_thread['v']:
        job['session'] = m.group(1)
    ok = code == 0 and os.path.exists(result)
    if not ok and (LIMIT_HIT.search(log_text[-4000:]) or LIMIT_HIT.search(read_text(events)[-4000:])):
        job['limitHit'] = True
    with state_lock:
        was_paused = paused['v'] and not cancelled['v'] and not ok
        job.update(status='cancelled' if cancelled['v'] else ('paused' if was_paused else ('done' if ok else 'failed')),
                   endedAt=now_iso(), exitCode=0 if was_paused else code)
        save_job(job)
    control_done.set()
    if control_thread:
        control_thread.join(1)
        os.close(control_read)
        os.close(control_write)
        os.unlink(control_path)

    print('codeome-agent: job %s %s (codex/%s%s, %s)' % (job_id, job['status'], role,
                                                        ', account ' + job['account'] if job.get('account') else '', duration(job)))
    if job.get('limitHit'):
        print('Codex hit a usage limit on this account. Do not retry it now: run `.codeome/bin/codeome-agent usage`, '
              'then send the job again (another account is picked if one has headroom) or stop and tell the user.')
    if job.get('session'):
        print('session: %s  (follow up with: --resume %s)' % (job['session'], job['session']))
    if worktree:
        print('worktree: %s  (branch %s)' % (os.path.relpath(worktree, ROOT), branch))
    print('result: %s' % os.path.relpath(result, ROOT))
    print('---')
    if os.path.exists(result):
        print(read_text(result).strip())
    else:
        print('\n'.join(read_text(log).strip().splitlines()[-30:]))
    sys.exit(0 if job['status'] in ('done', 'paused') else (130 if cancelled['v'] else 1))


# ---------- list / show / cancel ----------
def cmd_list(a):
    jobs = all_jobs()[:a.limit]
    if a.json:
        print(json.dumps(jobs, indent=2))
        return
    if not jobs:
        print('No jobs yet.')
        return
    for j in jobs:
        print('%-36s %-6s %-18s %-9s %8s  %s' % (j['id'], j.get('engine', ''), j.get('role', ''), j.get('status', ''), duration(j), j.get('title', '')))


def cmd_show(a):
    j = find_job(a.id)
    name = 'brief.md' if a.brief else 'log.txt' if a.log else 'result.md'
    text = read_text(os.path.join(job_dir(j['id']), name), None)
    print(text if text is not None else '(no %s for job %s, status %s)' % (name, j['id'], j.get('status')))


def cmd_cancel(a):
    j = find_job(a.id)
    if j.get('status') != 'running':
        sys.exit('codeome-agent: job %s is %s' % (j['id'], j.get('status')))
    if j.get('engine') != 'codex':
        sys.exit('codeome-agent: Claude subagents are stopped from their Claude Code session')
    os.kill(j['pid'], signal.SIGTERM)
    print('Cancelling %s' % j['id'])


def cmd_pause(a):
    j = find_job(a.id)
    if j.get('engine') != 'codex':
        sys.exit('codeome-agent: only Codex jobs can be paused')
    if j.get('status') != 'running' or not pid_alive(j.get('pid')):
        sys.exit('codeome-agent: job %s is %s' % (j['id'], j.get('status')))
    if not j.get('session'):
        sys.exit('codeome-agent: cannot pause job %s before its Codex session ID is captured' % j['id'])
    if not j.get('pauseFifo'):
        sys.exit('codeome-agent: job %s started with an older wrapper; update the agent kit and start a new job to pause safely' % j['id'])
    try:
        if not stat.S_ISFIFO(os.stat(j['pauseFifo']).st_mode):
            raise OSError('not a FIFO')
    except OSError:
        sys.exit('codeome-agent: the original wrapper for job %s is unavailable; refusing to signal its PID' % j['id'])
    reply_name = 'pause-reply-' + secrets.token_hex(8) + '.txt'
    reply_path = os.path.join(job_dir(j['id']), reply_name)
    try:
        fd = os.open(j['pauseFifo'], os.O_WRONLY | os.O_NONBLOCK)
        try:
            os.write(fd, (j['id'] + ' ' + reply_name + '\n').encode('ascii'))
        finally:
            os.close(fd)
    except OSError:
        sys.exit('codeome-agent: the original wrapper for job %s is unavailable; refusing to signal its PID' % j['id'])
    reply = None
    for _ in range(150):
        reply = read_text(reply_path, None)
        if reply:
            break
        time.sleep(0.02)
    try:
        os.unlink(reply_path)
    except FileNotFoundError:
        pass
    if reply != 'ok':
        sys.exit('codeome-agent: ' + (reply or 'the original wrapper did not acknowledge the pause'))
    print('Pausing %s' % j['id'])


# ---------- Claude Code hook ----------
def claude_gate():
    """Why a new Claude subagent must wait: this session's account is past the limit."""
    u = load_usage()
    if not u:
        return None
    now, stop_at = time.time(), u.get('stopAt', 90)
    key = account_key(os.environ.get('CLAUDE_CONFIG_DIR'))
    accounts = (u.get('claude') or {}).get('accounts') or []
    acct = next((x for x in accounts if (x.get('key') or account_key(x.get('dir'))) == key), None)
    lv = level(acct, now)
    if lv is None or lv < stop_at:
        return None
    others = [x.get('name') for x in accounts if x is not acct and (level(x, now) is None or level(x, now) < stop_at)]
    where = ('They can continue the plan on Claude account %s with Resume plan in Codeome\'s Agent chat.'
             % ' or '.join('"%s"' % o for o in others)) if others else 'No other Claude account has headroom; the limit resets as shown.'
    return ('Codeome: Claude account "%s" is at %s, past the %d%% limit, so new Claude subagents are paused. '
            'Do not retry this call. Send jobs whose role allows it to Codex (.codeome/bin/codeome-agent codex ...), '
            'otherwise stop and tell the user. %s' % (acct.get('name'), describe(acct, now), stop_at, where))


def cmd_hook(_a):
    # A hook must never disturb the session: swallow every error, print nothing,
    # except for a usage-limit refusal or a new subagent's job id.
    try:
        ev = json.load(sys.stdin)
        name = ev.get('hook_event_name')
        if name == 'PreToolUse' and ev.get('tool_name') == 'Agent':
            why = claude_gate()
            if why:
                print(json.dumps({'hookSpecificOutput': {'hookEventName': 'PreToolUse', 'permissionDecision': 'deny',
                                                         'permissionDecisionReason': why}}))
                return
            inp = ev.get('tool_input') or {}
            write_json(os.path.join(PENDING, safe(ev.get('tool_use_id') or secrets.token_hex(4)) + '.json'), {
                'type': inp.get('subagent_type') or 'general-purpose', 'description': inp.get('description') or '',
                'toolUseId': ev.get('tool_use_id'),
                'prompt': inp.get('prompt') or '', 'model': inp.get('model'), 'at': time.time()})
        elif name == 'SubagentStart' and ev.get('agent_type'):
            job_id = start_claude_job(ev)
            if job_id:
                context = ('Your Codeome job id is %s. To report progress run: '
                           '.codeome/bin/codeome-agent progress --job %s --stage <id> --state running --done N --total M'
                           % (job_id, job_id))
                print(json.dumps({'hookSpecificOutput': {'hookEventName': 'SubagentStart', 'additionalContext': context}}))
        elif name == 'SubagentStop' and ev.get('agent_type'):
            stop_claude_job(ev)
    except Exception:
        pass


def take_pending(agent_type):
    """The oldest unclaimed Agent call of this type: the brief behind a SubagentStart."""
    try:
        files = [os.path.join(PENDING, n) for n in os.listdir(PENDING) if n.endswith('.json')]
    except OSError:
        return {}
    items = []
    for p in files:
        try:
            with open(p, encoding='utf-8') as f:
                it = json.load(f)
        except (OSError, ValueError):
            continue
        if time.time() - it.get('at', 0) > 3600:
            os.remove(p)
            continue
        items.append((it.get('at', 0), p, it))
    for _, p, it in sorted(items, key=lambda x: x[0]):
        if it.get('type') == agent_type:
            os.remove(p)
            return it
    return {}


def agent_index(agent_id):
    return os.path.join(JOBS, '.agents', safe(agent_id))


def start_claude_job(ev):
    pend = take_pending(ev['agent_type'])
    job_id = new_job_id(ev['agent_type'])
    job = {
        'id': job_id, 'engine': 'claude', 'role': ev['agent_type'], 'title': pend.get('description') or ev['agent_type'],
        'status': 'running', 'startedAt': now_iso(), 'endedAt': None, 'exitCode': None,
        'cwd': ev.get('cwd') or ROOT, 'agentId': ev.get('agent_id'), 'session': ev.get('session_id'),
        'model': pend.get('model'), 'toolUseId': pend.get('toolUseId')
    }
    save_job(job)
    if pend.get('prompt'):
        write_text(os.path.join(job_dir(job_id), 'brief.md'), pend['prompt'])
    write_text(agent_index(ev.get('agent_id') or job_id), job_id)
    return job_id


def stop_claude_job(ev):
    job_id = read_text(agent_index(ev.get('agent_id') or ''), '').strip()
    job = load_job(job_id) if job_id else None
    if not job:
        # Hooks were installed mid-session, or the start was missed: record the outcome anyway.
        job_id = new_job_id(ev['agent_type'])
        job = {'id': job_id, 'engine': 'claude', 'role': ev['agent_type'], 'title': ev['agent_type'],
               'startedAt': now_iso(), 'cwd': ev.get('cwd') or ROOT, 'agentId': ev.get('agent_id'), 'session': ev.get('session_id')}
    job.update(status='done', endedAt=now_iso(), exitCode=0, transcript=ev.get('agent_transcript_path'))
    save_job(job)
    if ev.get('last_assistant_message'):
        write_text(os.path.join(job_dir(job_id), 'result.md'), ev['last_assistant_message'])
    try:
        os.remove(agent_index(ev.get('agent_id') or ''))
    except OSError:
        pass


def main():
    p = argparse.ArgumentParser(prog='codeome-agent', description='Codeome agent jobs')
    sub = p.add_subparsers(dest='cmd', required=True)
    c = sub.add_parser('codex', help='run a Codex specialist job (brief on stdin)')
    c.add_argument('--role')
    c.add_argument('--title')
    c.add_argument('--brief-file')
    c.add_argument('--worktree', action='store_true', help='run in a new git worktree on branch codeome/<job-id>')
    c.add_argument('--model')
    c.add_argument('--sandbox', choices=['read-only', 'workspace-write'])
    c.add_argument('--resume', metavar='SESSION', help='follow up in an earlier Codex session')
    c.add_argument('--account', help='run on this Codex account (default: the active one while it has headroom)')
    c.add_argument('--ignore-limits', action='store_true', help='start even when the account is past the usage limit')
    c.set_defaults(fn=cmd_codex)
    us = sub.add_parser('usage', help='Claude and Codex usage per account')
    us.add_argument('--json', action='store_true')
    us.set_defaults(fn=cmd_usage)
    ls = sub.add_parser('list', help='recent jobs')
    ls.add_argument('--json', action='store_true')
    ls.add_argument('--limit', type=int, default=20)
    ls.set_defaults(fn=cmd_list)
    sh = sub.add_parser('show', help="print a job's result (or brief/log)")
    sh.add_argument('id')
    g = sh.add_mutually_exclusive_group()
    g.add_argument('--brief', action='store_true')
    g.add_argument('--log', action='store_true')
    sh.set_defaults(fn=cmd_show)
    ca = sub.add_parser('cancel', help='stop a running Codex job')
    ca.add_argument('id')
    ca.set_defaults(fn=cmd_cancel)
    pa = sub.add_parser('pause', help='pause a running Codex job after its session starts')
    pa.add_argument('id')
    pa.set_defaults(fn=cmd_pause)
    pr = sub.add_parser('progress', help='record progress for a job stage')
    pr.add_argument('--job')
    pr.add_argument('--stage')
    pr.add_argument('--label')
    pr.add_argument('--state')
    pr.add_argument('--done')
    pr.add_argument('--total')
    pr.add_argument('--unit')
    pr.add_argument('--baseline')
    pr.add_argument('--plan')
    pr.set_defaults(fn=cmd_progress)
    wa = sub.add_parser('watch', help='follow a log and record task progress')
    wa.add_argument('--log')
    wa.add_argument('--remote-log')
    wa.add_argument('--jobs')
    wa.add_argument('--parser', required=True, choices=['vitest', 'pytest', 'tsc', 'snakemake', 'regex', 'slurm'])
    wa.add_argument('--total')
    wa.add_argument('--label', required=True)
    wa.add_argument('--task', required=True)
    wa.add_argument('--pid', type=int)
    wa.add_argument('--stage')
    wa.add_argument('--regex')
    wa.add_argument('--timeout')
    wa.add_argument('--quiet', action='store_true')
    wa.set_defaults(fn=cmd_watch)
    sub.add_parser('hook', help='Claude Code hook entry point').set_defaults(fn=cmd_hook)
    if sys.argv[1:2] in (['progress'], ['watch']):
        def progress_error(message):
            print('codeome-agent: warning: %s: %s' % (sys.argv[1], message), file=sys.stderr)
            raise SystemExit(0)
        p.error = (pr if sys.argv[1] == 'progress' else wa).error = progress_error
    a = p.parse_args()
    if a.cmd in ('progress', 'watch'):
        try:
            a.fn(a)
        except Exception as e:
            print('codeome-agent: warning: %s: %s' % (a.cmd, e), file=sys.stderr)
    else:
        a.fn(a)


if __name__ == '__main__':
    main()
