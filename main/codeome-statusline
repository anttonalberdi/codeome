#!/usr/bin/env python3
"""codeome-statusline — status line for Claude Code sessions started by Codeome.

Claude Code passes the session's rate-limit usage to its status line. This script
records it in ~/.codeome/usage/claude-<account>.json, where Codeome's usage bars
and codeome-agent's limit checks read it, and then shows your own status line
(project or user settings) or, if you have none, a short default.
"""
import json
import os
import re
import subprocess
import sys
import time

HOME = os.environ.get('CODEOME_HOME') or os.path.expanduser('~/.codeome')


def account_key(d):
    # Same rule as accountKey() in Codeome's main/usage.js.
    if not d:
        return 'default'
    return re.sub(r'[^A-Za-z0-9]+', '_', os.path.realpath(os.path.expanduser(d))).strip('_')


def record(rate_limits):
    d = os.path.join(HOME, 'usage')
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, 'claude-%s.json' % account_key(os.environ.get('CLAUDE_CONFIG_DIR')))
    tmp = '%s.%d.tmp' % (p, os.getpid())
    with open(tmp, 'w', encoding='utf-8') as f:
        json.dump({'dir': os.environ.get('CLAUDE_CONFIG_DIR') or '', 'at': time.time(), 'rate_limits': rate_limits}, f)
    os.replace(tmp, p)


def own_command(data):
    """Your status line, in Claude Code's order: local project, project, user settings."""
    proj = ((data.get('workspace') or {}).get('project_dir')) or data.get('cwd') or ''
    user = os.environ.get('CLAUDE_CONFIG_DIR') or os.path.expanduser('~/.claude')
    for p in [os.path.join(proj, '.claude', 'settings.local.json'), os.path.join(proj, '.claude', 'settings.json'), os.path.join(user, 'settings.json')]:
        try:
            with open(p, encoding='utf-8') as f:
                sl = json.load(f).get('statusLine') or {}
        except (OSError, ValueError, AttributeError):
            continue
        cmd = sl.get('command') if isinstance(sl, dict) else None
        if cmd and 'codeome-statusline' not in cmd:
            return cmd
    return None


def default_line(data):
    parts = [((data.get('model') or {}).get('display_name')) or '']
    ctx = (data.get('context_window') or {}).get('used_percentage')
    if ctx is not None:
        parts.append('ctx %d%%' % ctx)
    rl = data.get('rate_limits') or {}
    for key, label in (('five_hour', '5h'), ('seven_day', 'wk')):
        w = rl.get(key) or {}
        if w.get('used_percentage') is not None:
            parts.append('%s %d%%' % (label, w['used_percentage']))
    return ' · '.join(p for p in parts if p)


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except ValueError:
        data = {}
    rl = data.get('rate_limits')
    if isinstance(rl, dict) and (rl.get('five_hour') or rl.get('seven_day')):
        try:
            record(rl)
        except OSError:
            pass
    cmd = own_command(data)
    if cmd:
        try:
            r = subprocess.run(cmd, shell=True, input=raw, capture_output=True, text=True, timeout=5)
            sys.stdout.write(r.stdout)
            return
        except (OSError, subprocess.TimeoutExpired):
            pass
    print(default_line(data))


if __name__ == '__main__':
    main()
