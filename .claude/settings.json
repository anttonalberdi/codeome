{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.codeome/bin/codeome-agent\" hook"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.codeome/bin/codeome-agent\" hook"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.codeome/bin/codeome-agent\" hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.codeome/bin/codeome-agent *)"
    ]
  }
}
