{
  "name": "codeome",
  "productName": "Codeome",
  "version": "1.8.0",
  "description": "One Mac app for R/Python work on your laptop and HPC: editor, terminals, Claude Code & Codex sessions, Slurm, file transfer, reports, GitHub, Zenodo and PyPI.",
  "homepage": "https://www.alberdilab.dk/codeome/",
  "main": "main/main.js",
  "author": "Antton Alberdi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --mac && electron-builder install-app-deps",
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke-win.js",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dk.ku.codeome",
    "productName": "Codeome",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": "-"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "maintainer": "Antton Alberdi <antton.alberdi@sund.ku.dk>",
      "synopsis": "R/Python workbench with Claude Code, Codex and HPC tools",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "files": [
      "main/**",
      "renderer/**",
      "kit/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "**/node_modules/node-pty/**",
      "kit/**"
    ]
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
