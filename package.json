{
  "name": "codeome",
  "productName": "Codeome",
  "version": "0.5.0",
  "description": "One Mac app for R/Python work on your laptop and HPC: editor, terminals, Claude Code & Codex sessions, Slurm, file transfer, reports, GitHub, Zenodo and PyPI.",
  "homepage": "https://anttonalberdi.github.io/codeome/",
  "main": "main/main.js",
  "author": "Antton Alberdi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder --mac && electron-builder install-app-deps",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dk.ku.codeome",
    "productName": "Codeome",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "identity": "-"
    },
    "files": [
      "main/**",
      "renderer/**",
      "kit/**",
      "node_modules/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "kit/**"
    ]
  }
}
